# Python
__pycache__/
*.pyc

# Media
*.mov

# Generated data (root-anchored: electron/main/data/ is source code)
/data/
!/data/
/data/*
!/data/README.md
!/data/external/
/data/external/*
!/data/external/untapped/
!/data/external/untapped/*.json
!/data/feedback/
!/data/feedback/*.json
app/data/

# Electron build artifacts
electron/node_modules/
electron/dist/
electron/out/
electron/release/
*.dmg

# E2E screenshots (regenerated by electron/tests/e2e/drive.mjs)
electron/tests/e2e/shots/*
!electron/tests/e2e/shots/.gitkeep

# OS files
.DS_Store
.venv/
.venv-ml/
.venv-fm/
.venv-embed/

# Paper data mirror: local cache synced from remote training boxes for
# scripts/make_paper_tables.py. Contains absolute paths with remote account
# names (not a redaction concern for the paper itself -- the generated
# tables/*.tex never leak these -- but shouldn't be committed). Reproducible
# from experiments/ledger.jsonl + the training runs.
paper/data/runs/
