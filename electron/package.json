{
  "name": "mtga-tracker",
  "version": "0.1.0",
  "description": "MTGA Draft Assistant \u2014 a draft overlay for MTG Arena with local DraftFM recommendations",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "build:native": "bash scripts/build-native.sh",
    "package": "npm run build && electron-builder --mac --arm64",
    "package:dir": "npm run build && electron-builder --mac --arm64 --dir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/drive.mjs",
    "bundle:sets": "cd .. && .venv/bin/python scripts/build_app_bundle.py --all-curated",
    "install:local": "bash scripts/install-local.sh"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "onnxruntime-node": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.mtga.draft-assistant",
    "productName": "MTGA Draft Assistant",
    "files": [
      "dist/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/x64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/native",
        "to": "native"
      },
      {
        "from": "resources/draftfm",
        "to": "draftfm"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureUsageDescription": "Used only to lift card badges from under Arena's own card previews and menus. Only the Arena window is captured; nothing is recorded or stored."
      }
    },
    "directories": {
      "output": "release"
    }
  }
}
