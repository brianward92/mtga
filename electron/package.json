{
  "name": "mtga-tracker",
  "version": "0.1.0",
  "description": "MTGA draft assistant, log parser, and overlay",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "deploy:mbp": "bash scripts/deploy-mbp.sh",
    "typecheck": "tsc --noEmit",
    "build:native": "bash scripts/build-native.sh",
    "test": "vitest run",
    "e2e": "node tests/e2e/drive.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo '[postinstall] electron-rebuild skipped (dev deps absent or offline); npm run dev needs it, prod installs do not'"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "chokidar": "^4.0.3",
    "onnxruntime-node": "^1.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "better-sqlite3-node": "npm:better-sqlite3@^11.6.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.mtga.tracker",
    "productName": "MTGA Draft Assistant",
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/native",
        "to": "native"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
